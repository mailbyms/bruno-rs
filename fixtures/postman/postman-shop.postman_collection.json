{
  "info": {
    "_postman_id": "6f1b3a1e-0000-4000-8000-000000000001",
    "name": "Postman Shop",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Fixture for bruno-rs import verification"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:18081" },
    { "key": "token", "value": "demo-token" }
  ],
  "item": [
    {
      "name": "Orders",
      "description": "Order related requests",
      "item": [
        {
          "name": "List Orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-From", "value": "postman" }],
            "url": {
              "raw": "{{baseUrl}}/orders?limit=2",
              "host": ["{{baseUrl}}"],
              "path": ["orders"],
              "query": [{ "key": "limit", "value": "2" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.expect(pm.response.code).to.equal(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Create Order",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"item\":\"coffee\",\"qty\":2}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/echo",
          "host": ["{{baseUrl}}"],
          "path": ["echo"]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": ["pm.environment.set('fromPostman', 'yes');"]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('echo body contains coffee', function () {",
              "  pm.expect(pm.response.json().body).to.include('coffee');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
