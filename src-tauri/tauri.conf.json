{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bruno RS",
  "version": "0.1.0",
  "identifier": "app.brunors.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix web run dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "npm --prefix web run build",
    "frontendDist": "../web/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Bruno RS",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": true,
        "dragDropEnabled": true,
        "devtools": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png", "icons/32x32.png", "icons/icon.icns"],
    "shortDescription": "OpenCollection-native API client",
    "longDescription": "A Rust/Tauri API client for OpenCollection YAML collections"
  }
}
